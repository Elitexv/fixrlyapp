# Copy this file to .env and fill in real values. Never commit .env itself.

# Browser-side Supabase client (safe to expose; protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side copies — required by server functions (auth-middleware.ts,
# geocode.functions.ts, booking-notifications.functions.ts). These run in a
# Node/Worker context that only sees process.env, not import.meta.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key for trusted server-only operations (client.server.ts).
# Full RLS bypass — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side geocoding (Geocoding API must be enabled for this key).
GOOGLE_MAPS_API_KEY=

# Browser map rendering (Maps JavaScript API must be enabled for this key).
# Can also be set at runtime via Admin -> Manage Map, which takes priority.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Booking notification emails (booking-notifications.functions.ts)
EMAIL_FROM=
LOVABLE_API_KEY=
