# Copy this file to .env and fill in real values. Never commit .env itself.

# Browser-side Supabase client (safe to expose; protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Web push VAPID public key (safe to expose — pairs with VAPID_PRIVATE_KEY,
# set as a `supabase secrets set` edge function secret, never in this file).
# Generate a pair with `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=

# Firebase Auth (browser client config — safe to expose, not secret by
# design). From Firebase Console -> Project Settings -> General -> Web app.
# Supabase trusts Firebase ID tokens directly via Third-Party Auth (see
# supabase/config.toml); the Admin SDK service-account JSON used server-side
# to verify tokens/manage users is a real secret and goes in Supabase edge
# function secrets, never here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check reCAPTCHA v3 site key (safe to expose — a site key is public by
# design, same trust level as the Firebase config above). From Firebase
# Console -> Build -> App Check -> register the web app with the reCAPTCHA v3
# provider; Firebase auto-generates the key. Left unset, App Check silently
# stays off (see integrations/firebase/client.ts) rather than breaking auth.
VITE_RECAPTCHA_SITE_KEY=

# Server-side copies — required by server functions (auth-middleware.ts,
# geocode.functions.ts, booking-notifications.functions.ts). These run in a
# Node/Worker context that only sees process.env, not import.meta.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key for trusted server-only operations (client.server.ts).
# Full RLS bypass — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side geocoding (Geocoding API must be enabled for this key).
GOOGLE_MAPS_API_KEY=

# Browser map rendering (Maps JavaScript API must be enabled for this key).
# Can also be set at runtime via Admin -> Manage Map, which takes priority.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_TRACKING_ID=

# Booking notification emails (booking-notifications.functions.ts)
EMAIL_FROM=
LOVABLE_API_KEY=

# Paystack secret keys (server-only; payments.functions.ts and the
# server/routes/webhooks/paystack.post.ts webhook). Never expose to the browser.
# Which one gets used is decided per-request by the admin_settings "Mode"
# toggle (Admin -> Payments): Live uses PAYSTACK_SECRET_KEY, Test uses
# PAYSTACK_TEST_SECRET_KEY. Set both so switching Mode in the admin UI
# actually switches which key charges run against.
# The Paystack *publishable* key goes in admin_settings via Admin -> Payments,
# not here — use the test pk_test_... key while Mode is Test.
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=

# Firebase Admin SDK service account (server-only; auth-middleware.ts verifies
# Firebase ID tokens with this, firebase-admin also uses it for the bulk user
# import script). Full admin credentials for the Firebase project — never
# expose to the browser. The whole service-account JSON as a single-quoted,
# single-line value (Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key). Single-quote it, not double — the key
# contains literal \n sequences that double-quoted dotenv parsing would break.
FIREBASE_SERVICE_ACCOUNT_KEY=
